# Stamper — consolidated environment (every variable of every work package).
# Copy to infra/.env. Active values are SAFE DEFAULTS FOR THE DEV PROFILE; lines marked PROD: show
# what changes on the VPS. Keys and secrets NEVER go in this file:
#   * service keys are Docker secrets (infra/secrets/, mounted into api only);
#   * FOC_PAYER_PK and DEPLOYER_PK are exported in a laptop shell for one ceremony, then unset.
# Commented "# KEY=" lines are documented but normally left unset.

# ── Compose / edge ──────────────────────────────────────────────────────────────────────────
COMPOSE_PROFILES=dev                 # PROD: prod
DOMAIN=localhost                     # PROD: the public host name (same host as PUBLIC_ORIGIN in @stamper/core)
APP_DOMAIN=app.localhost             # PROD: the app's host name, e.g. app.stamper.media
ACME_EMAIL=ops@example.invalid       # PROD: mailbox for Let's Encrypt notices
# API_IMAGE=stamper-api:latest
# WEB_IMAGE=stamper-explorer:latest
# APP_IMAGE=stamper-app:latest
# Sibling checkouts the images are built from (defaults: ../../stamper-<name> from infra/)
# STAMPER_SERVICES_DIR=../../stamper-services
# STAMPER_EXPLORER_DIR=../../stamper-explorer
# STAMPER_APP_DIR=../../stamper-app
# ML_IMAGE=stamper-ml:latest
# CADDY_IMAGE=caddy:2-alpine
# POSTGRES_IMAGE=pgvector/pgvector:pg17
# BACKUP_IMAGE=offen/docker-volume-backup:v2
# FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:v1.3.5
# NODE_IMAGE=node:22-bookworm-slim

# ── Dev profile (host ports; all bound to 127.0.0.1, none of them default dev ports) ─────────
DEV_ANVIL_PORT=18545
DEV_PG_PORT=15432
DEV_PG_PASSWORD=stamper
DEV_ML_PORT=18000
DEV_HTTPS_PORT=18443
DEV_MOCK_SP_PORT=17878               # standalone mock SP container (the mock-mode api serves MOCK_SP_PORT itself)
DEV_STAGING_DIR=./.dev/staging
API_PORT=18080                       # host port of `pnpm dev` api (Caddy dev upstream)
WEB_PORT=13000                       # host port of `pnpm dev` web (Caddy dev upstream)
ANVIL_RPC_URL=http://127.0.0.1:18545

# ── Process role and HTTP (services/api; ROLE is set by compose per container) ───────────────
# ROLE=api                           # api | worker
HOST=0.0.0.0
PORT=18080                           # compose pins 8080 inside the containers
LOG_LEVEL=info                       # fatal|error|warn|info|debug|trace

# ── Database (Postgres 17 + pgvector) ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://stamper:stamper@127.0.0.1:15432/stamper   # PROD: built by compose from POSTGRES_*
POSTGRES_USER=stamper
POSTGRES_PASSWORD=change-me-hex-only # PROD: `openssl rand -hex 24` (hex keeps the URL valid)
POSTGRES_DB=stamper
SCHEMA_WAIT_MS=60000

# ── Chain and contracts (written by scripts/deploy-*.sh into infra/env/<net>.env) ────────────
CHAIN_ID=31337                       # PROD: 314159 Calibration, 314 mainnet
RPC_URLS=http://127.0.0.1:18545      # comma-separated; PROD: at least two providers
REGISTRY_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
RESOLVER_ADDRESS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
PDP_VERIFIER_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3   # PROD: defaults per chain
FWSS_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0           # PROD: defaults per chain
REORG_DEPTH=0                        # anvil 0, Filecoin 2
RECEIPT_TIMEOUT_MS=180000

# Deploy-time only (laptop; read by contracts/script/*.s.sol and infra/scripts/deploy-*.sh).
CALIBRATION_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
# CALIBRATION_RPC_URLS=              # comma list written into calibration.env (defaults to CALIBRATION_RPC_URL)
# MAINNET_RPC_URL=
# MAINNET_RPC_URLS=
BLOCKSCOUT_URL=https://filecoin-testnet.blockscout.com/api/
# MAINNET_BLOCKSCOUT_URL=https://filecoin.blockscout.com/api/
# VERIFY_INDEX_TIMEOUT_S=900          # deploy-*.sh: wait for Blockscout to index the creation input
# VERIFY_STATUS_TIMEOUT_S=180         # deploy-*.sh: wait for Blockscout to report the sources verified
# VERIFY_POLL_INTERVAL_S=15
# DEPLOYER_PK=                       # Calibration governor; export in the shell, never store here
# GOVERNOR_ADDR=                     # mainnet hardware-wallet sender
# HW_WALLET=ledger                   # ledger | trezor
# REGISTRAR_ADDR=
# BINDER_ADDR=
# RESOLVER_OWNER_ADDR=
# EXTRA_REGISTRARS=                  # comma list announced through Roles.s.sol after deploy
# EXTRA_BINDERS=
# PDP_VERIFIER=                      # override the per-chain default inside Deploy.s.sol
# FWSS=
# MOCK_SP_A=                         # DeployLocal mock provider addresses
# MOCK_SP_B=
# DEPLOYMENTS_OUT=deployments/anvil.json
# STAMPER_HEAVY_LOCK=                # optional flock file wrapped around forge (shared dev hosts)
# STAMPER_PNPM_LOCK=                 # optional flock file wrapped around pnpm

# ── Filecoin Onchain Cloud (@stamper/foc) ─────────────────────────────────────────────────────
FOC_MODE=mock                        # PROD: real
FOC_CHAIN_ID=31337                   # PROD: 314159 / 314
# FOC_RPC_URL=                       # PROD: https://api.calibration.node.glif.io/rpc/v1
# FOC_PAYER_ADDRESS=                 # PROD: payer wallet address (key stays on the laptop)
FOC_DATASET_A_ID=1
FOC_DATASET_A_PROVIDER_ID=1
FOC_DATASET_B_ID=2
FOC_DATASET_B_PROVIDER_ID=2
MOCK_SP_DIR=/tmp/stamper-mock-sp   # absolute: shared by the host api and the mock-sp container
MOCK_SP_PORT=7878
# FOC_SESSION_ADDRESS=               # address of the api session key (scripts/foc-session-rotate.sh)
# FOC_PAYER_PK=                      # scripts only, laptop shell only; the api refuses to boot with it

# ── Attestation and app identity ─────────────────────────────────────────────────────────────
ATTEST_MODE=stub                     # PROD: strict (stub tokens are rejected)
# APPLE_TEAM_ID=
IOS_BUNDLE_ID=media.stamper.app
APPLE_APP_ATTEST_ENV=development     # PROD: production
ANDROID_PACKAGE=media.stamper.app
# ANDROID_CERT_SHA256=
# PLAY_CLOUD_PROJECT_NUMBER=
# CAPTURE_CHALLENGE_TTL_S=3600       # services/api: capture challenge lifetime (300..86400 s)
# WEB_CAPTURE=1                      # services/api: 1 (compose default) accepts captures from web keys (attestation "none"); 0 turns the app's capture off

# ── Docker-secret paths (set by compose in the api container ONLY; never in .env) ──────────────
# RELAYER_PK_FILE=/run/secrets/relayer_pk
# REGISTRAR_PK_FILE=/run/secrets/registrar_pk
# FOC_SESSION_PK_FILE=/run/secrets/foc_session_pk
# RESOLVER_OWNER_PK_FILE=/run/secrets/resolver_owner_pk
# RECORD_WRAP_KEY_FILE=/run/secrets/record_wrap_key
# PLAY_SA_JSON_FILE=/run/secrets/play_sa_json
# FOC_SESSION_PK=                    # packages/foc Calibration integration test only (laptop shell)

# ── Upload limits ─────────────────────────────────────────────────────────────────────────────
MAX_IMAGE_BYTES=52428800
MAX_VIDEO_BYTES=524288000
MAX_VIDEO_SECONDS=180

# ── Files, mirror and media tools ─────────────────────────────────────────────────────────────
STAGING_DIR=./.dev/staging           # compose: /srv/staging
CACHE_DIR=./.dev/cache               # compose: /srv/cache
MODELS_DIR=./.dev/models             # compose: /models
ML_URL=http://127.0.0.1:18000        # compose: http://ml:8000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# MIRROR_S3_ENDPOINT=
# MIRROR_S3_BUCKET=
# MIRROR_S3_REGION=
# MIRROR_S3_ACCESS_KEY_ID=           # worker writes; api reads unless READ pair below is set
# MIRROR_S3_SECRET_ACCESS_KEY=
# Optional read-only key pair for the api's /original mirror fallback (defaults to the pair above).
# MIRROR_S3_READ_ACCESS_KEY_ID=
# MIRROR_S3_READ_SECRET_ACCESS_KEY=
PUBLIC_BASE_URL=https://localhost:18443   # PROD: https://$DOMAIN
VERIFY_BASE_URL=https://localhost:18443   # PROD: https://$DOMAIN

# ── ML sidecar (services/ml) ──────────────────────────────────────────────────────────────────
ML_PORT=8000
TRUSTMARK_VARIANT=Q
TRUSTMARK_SCHEMA=BCH_SUPER
TRUSTMARK_STRENGTH=1.0
TORCH_NUM_THREADS=4
MAX_IMAGE_PIXELS=50000000
ML_WATERMARK=trustmark
# TRUSTMARK_WEIGHTS_URL=

# ── Explorer and app (stamper-explorer, stamper-app; NEXT_PUBLIC_* are baked in at build time) ──────────────────────────
NEXT_PUBLIC_ORIGIN=https://localhost:18443          # PROD: https://$DOMAIN
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URLS=http://127.0.0.1:18545         # PROD: >= 2 public providers
NEXT_PUBLIC_REGISTRY_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
NEXT_PUBLIC_RESOLVER_ADDRESS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
NEXT_PUBLIC_API_URL=https://localhost:18443
NEXT_PUBLIC_VERIFY_BASE_URL=https://localhost:18443
# NEXT_PUBLIC_FILBEAM_PAYER=
# NEXT_PUBLIC_FILBEAM_BASE=
# NEXT_PUBLIC_MIRROR_URL=
# NEXT_PUBLIC_EXPLORERS=
# NEXT_PUBLIC_EXAMPLES=              # "CODE|Title|/examples/thumb.jpg|demo[|/examples/copy.jpg];…" (Explorer home chips)
NEXT_PUBLIC_APP_URL=https://app.localhost:18443       # PROD: https://$APP_DOMAIN (the app's origin and api base)

# ── Mobile (apps/mobile; EXPO_PUBLIC_* are baked into the bundle) ─────────────────────────────
EXPO_PUBLIC_API_URL=https://localhost:18443
EXPO_PUBLIC_CHAIN_ID=31337
EXPO_PUBLIC_REGISTRY_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
EXPO_PUBLIC_VERIFY_BASE_URL=https://localhost:18443
EXPO_PUBLIC_ATTEST_MODE=stub        # PROD: real
# EXPO_PUBLIC_PLAY_CLOUD_PROJECT_NUMBER=
# EAS_PROJECT_ID=

# ── Backups (offen/docker-volume-backup → S3-compatible bucket; prod only) ──────────────────────
# BACKUP_S3_ENDPOINT=s3.example.invalid
# BACKUP_S3_BUCKET=
# BACKUP_S3_PATH=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_GPG_PASSPHRASE=             # strongly recommended: encrypts archives client-side
# BACKUP_CRON_EXPRESSION=30 3 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_NOTIFICATION_URLS=

# ── Observability (scripts/healthcheck.sh) ───────────────────────────────────────────────────
# NTFY_URL=https://ntfy.sh/<private-topic>
# HC_MAX_QUEUE_AGE_S=600
# HC_MAX_TX_LATENCY_S=300
# HC_MAX_PROBE_FAILURES=0
# HC_MIN_RUNWAY_DAYS=60

# ── Tests and e2e (never needed in prod) ─────────────────────────────────────────────────────
# TEST_DATABASE_URL=
# TEST_LOG_LEVEL=
# E2E_SKIP_ML=0
# E2E_SKIP_WEB=0
# E2E_WEB_PORT=
# API_URL=                           # e2e/flow.ts: api base URL (set by e2e/run-*.sh)
# RPC_URL=                           # e2e/flow.ts, e2e/roles.ts
# DEPLOYMENT_JSON=                   # e2e: path to contracts/deployments/<net>.json
# E2E_MODE=                          # e2e report label
# E2E_OUT_DIR=./out
# E2E_PLATFORM=
# E2E_SKIP_VIDEO=0
# E2E_STEP_TIMEOUT_S=240
# E2E_ROLE_WAIT_S=0                  # e2e/roles.ts: wait this long for announced roles to activate
# E2E_LOCATION=                      # e2e/flow.ts: "lat,lon[,accuracyM]" records a location
# E2E_PHOTO=                         # e2e/flow.ts: stamp this JPEG instead of the generated one
# STAMPER_PROTOCOL_DIR=              # stamper-services tests/e2e: protocol checkout (default ../stamper-protocol)
# STAMPER_REPOS_DIR=                 # infra/scripts/check-env.mjs: folder holding the four repos
# LIVE_CAPTURE=0                     # stamper-app: 1 runs the live browser-capture test
# LIVE_CAPTURE_OUT=                  # stamper-app live test: file that receives the stamp code
# EXPLORER_BASE_URL=                 # stamper-app live test: the Explorer's origin
# REGISTRAR_PK=                      # e2e/roles.ts on Calibration; export in the shell, never store here
# RELAYER_PK=                        # e2e/roles.ts on Calibration; export in the shell, never store here
# CORS_PROXY_PORT=                   # e2e/lib/cors-proxy.ts
# CORS_PROXY_ROUTES=                 # e2e/lib/cors-proxy.ts: "api=http://127.0.0.1:<port>,sp=http://…"
# FIXTURE_PORT=
# PLAYWRIGHT_BASE_URL=
# STAMP_CODE=
# UPDATE_GOLDEN=0
# SMOKE_SKIP_ML=0
# SMOKE_SKIP_API=0
