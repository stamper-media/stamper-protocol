{
  "name": "@stamper/core",
  "version": "0.1.0",
  "description": "Stamper primitives: content identifiers, stamp codes, capture claims, records, verdict ladder",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamper-media/stamper-protocol.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-pure": "node ../../scripts/check-pure.mjs ."
  },
  "dependencies": {
    "@filoz/synapse-core": "catalog:",
    "@ipld/dag-cbor": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "abitype": "catalog:",
    "multiformats": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
