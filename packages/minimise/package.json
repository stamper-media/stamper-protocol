{
  "name": "@stamper/minimise",
  "version": "0.1.0",
  "description": "Pure-TS EXIF / MP4 metadata minimiser and inspector (no pixel or sample re-encode)",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamper-media/stamper-protocol.git",
    "directory": "packages/minimise"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-pure": "node ../../scripts/check-pure.mjs .",
    "fixtures": "sh scripts/make-fixtures.sh"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "exifr": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
