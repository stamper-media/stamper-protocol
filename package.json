{
  "name": "stamper-protocol",
  "private": true,
  "version": "0.1.0",
  "description": "Stamper protocol: FEVM contracts (StampRegistry, StampResolver), the shared @stamper/* TypeScript packages, and the infra that deploys the stack.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:anvil": "pnpm -r --if-present test:anvil",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check-pure": "node scripts/check-pure.mjs",
    "test:contracts": "forge test --root contracts",
    "test:infra": "node --test infra/test/*.test.mjs",
    "abi": "pnpm --filter @stamper/contracts-abi generate",
    "pack:packages": "node scripts/pack-packages.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
